# Uptimer — protections de base (Apache / LiteSpeed, o2switch compatible)

DirectoryIndex index.php

# Interdit l'accès direct au code, aux données et à la configuration
<FilesMatch "^(config\.php|config\.sample\.php|composer\.json|README\.md|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# « bin » est dans cette liste depuis le 2026-07-31. Les suites de tests et les
# outils de maintenance vivent sous la racine web sur une installation ordinaire :
# chacun porte désormais sa garde « ligne de commande seulement », et ce refus est
# la seconde barrière, celle qui vaut aussi pour bin/e2e-browser.mjs, qu'aucune
# garde PHP ne protège.
RedirectMatch 404 ^/(.*/)?(src|data|views|bin)/.*$

# Pas d'indexation de l'outil
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Cache des assets statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
